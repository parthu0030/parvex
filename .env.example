# ─────────────────────────────────────────────────────────────────────────
# PARVEX — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────

# DATABASE ------------------------------------------------------------------
# PostgreSQL connection string. Any managed Postgres works (Neon, Supabase,
# Railway, RDS, etc). After setting this, run:
#   npm install
#   npx prisma generate
#   npx prisma migrate deploy   (or `npx prisma db push` for a fresh DB)
#   npm run db:seed
DATABASE_URL="postgresql://user:password@host:5432/parvex?schema=public"

# AUTH (Better Auth) ----------------------------------------------------------
# Generate a strong secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# The deployed base URL of this app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
# Used client-side by the Better Auth client — should match BETTER_AUTH_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# INITIAL SUPER_ADMIN ---------------------------------------------------------
# Only used once, by `npm run db:seed`, to create the first Admin account.
# After the first login, create additional users from /admin/users instead.
PARVEX_INITIAL_ADMIN_EMAIL="you@parvex.in"
PARVEX_INITIAL_ADMIN_PASSWORD="choose-a-strong-password-12-chars-min"
PARVEX_INITIAL_ADMIN_NAME="Parvex Admin"

# MEDIA (Cloudinary) ----------------------------------------------------------
# All uploaded media (projects, services, contact attachments) is stored
# here — never in Git or local disk. Free tier is enough to start.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# EMAIL — contact / project enquiry notifications ------------------------------
# Every successful enquiry is emailed to the studio inbox (parvex3303@gmail.com)
# plus everyone listed in CONTACT_NOTIFY_EMAILS / CONTACT_FALLBACK_EMAIL.
# The visitor only sees "received" once the email has actually been sent.
# Keep private addresses here and in your hosting env vars only: this repo is public.
CONTACT_NOTIFY_EMAILS=""          # comma-separated, e.g. "you@gmail.com,team@example.com"
CONTACT_FALLBACK_EMAIL=""         # optional extra recipient (older setting, still honoured)

# Provider: "smtp" or "resend". Leave empty to choose automatically
# (SMTP when SMTP_HOST/SMTP_USER/SMTP_PASS are set, otherwise Resend).
# "preview" (development only) sends nothing and reports success.
EMAIL_PROVIDER=""

# Option A — SMTP (works without owning a domain). For Gmail: turn on 2-Step
# Verification, create an App Password (Google Account > Security > App
# passwords), and send from that same Gmail address.
SMTP_HOST=""                      # smtp.gmail.com
SMTP_PORT=""                      # 465 (SSL) or 587 (STARTTLS)
SMTP_USER=""                      # parvex3303@gmail.com
SMTP_PASS=""                      # the 16-character App Password, not your login password
SMTP_FROM=""                      # optional; defaults to SMTP_USER

# Option B — Resend. RESEND_FROM_EMAIL must be on a domain verified in Resend
# (e.g. "Parvex <enquiries@parvex.in>"). Without a verified domain Resend's test
# sender only delivers to the inbox that owns the Resend account.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
